[Unit]
Description=Steadfast API (Flattrade production trading)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=steadfast-api
Group=steadfast-api
SupplementaryGroups=steadfast
WorkingDirectory=/opt/steadfast/steadfast-api
EnvironmentFile=/etc/steadfast/api.env
ExecStart=/usr/bin/env NODE_ENV=production API_HOST=127.0.0.1 PORT=3001 CORS_ORIGIN=https://trade.nagabyte.com TRADING_ENABLED=true DRY_RUN=false node server.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
StateDirectory=steadfast-api
StateDirectoryMode=0700
ReadWritePaths=/opt/steadfast/steadfast-api/symbols

[Install]
WantedBy=multi-user.target
